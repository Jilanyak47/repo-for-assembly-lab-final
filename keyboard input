.MODEL SMALL
.STACK 100H

.CODE
MAIN PROC

    MOV AH, 01H
    INT 21H
    SUB AL, 30H
    MOV BL, AL

    MOV AH, 01H
    INT 21H
    SUB AL, 30H
    MOV BH, AL

    MOV AH, 01H
    INT 21H
    SUB AL, 30H
    MOV CL, AL

    MOV AL, BL
    CMP AL, BH
    JA CHECK3
    MOV AL, BH

CHECK3:
    CMP AL, CL
    JA RESULT
    MOV AL, CL

RESULT:
    ADD AL, 30H
    MOV DL, AL
    MOV AH, 02H
    INT 21H

    MOV AH, 4CH
    INT 21H

MAIN ENDP
END MAIN
